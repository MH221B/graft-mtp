+static bool dump_mtp_output(
+        llama_model * model,
+        llama_context * ctx_tgt,
+        const common_params & params,
+        const std::vector<int32_t> & ids,
+        const std::vector<float> & hidden,
+        const int n_embd);
+
+// Dump the trunk's nextn hidden state for every token of the --tokens file.
+//
+// The hidden state is the one after model.output_norm (see docs/notes/mtp-forward.md). Rows
+// from --dump-nextn-seqs are decoded one at a time, each with a cleared KV: a row decoded
+// after another row would attend to it, and those are not the states the runtime produces.
+static bool dump_nextn_hidden(llama_model * model, llama_context * ctx, const common_params & params) {
+    const int n_embd  = llama_model_n_embd(model);
+    const int n_batch = params.n_batch;
+
+    std::vector<int32_t> ids;
+    std::vector<int32_t> seqs;
+    try {
+        ids = read_i32_file(params.tokens_file);
+        if (!params.dump_nextn_seqs.empty()) {
+            seqs = read_i32_file(params.dump_nextn_seqs);
+        }
+    } catch (const std::exception & err) {
+        LOG_ERR("%s: %s\n", __func__, err.what());
+        return false;
+    }
+
+    if (seqs.size() % 2 != 0) {
+        LOG_ERR("%s: --dump-nextn-seqs must hold (offset, length) pairs\n", __func__);
+        return false;
+    }
+
+    llama_set_embeddings_nextn(ctx, true, false);
+
+    std::vector<float> hidden;
+    hidden.reserve(ids.size() * n_embd);
+
+    const int n_rows = seqs.empty() ? 1 : (int) seqs.size() / 2;
+    LOG_INF("%s: %d rows, %zu tokens, n_embd = %d, n_batch = %d\n", __func__, n_rows, ids.size(), n_embd, n_batch);
+
+    for (int r = 0; r < n_rows; ++r) {
+        const int off = seqs.empty() ? 0 : seqs[2*r + 0];
+        const int len = seqs.empty() ? (int) ids.size() : seqs[2*r + 1];
+        if (off < 0 || len <= 0 || off + len > (int) ids.size()) {
+            LOG_ERR("%s: row %d (offset %d, length %d) is outside the token file\n", __func__, r, off, len);
+            return false;
+        }
+
+        llama_memory_clear(llama_get_memory(ctx), true);
+
+        for (int start = 0; start < len; start += n_batch) {
+            const int n = std::min(n_batch, len - start);
+            llama_batch batch = llama_batch_init(n, 0, 1);
+            for (int k = 0; k < n; ++k) {
+                common_batch_add(batch, ids[off + start + k], start + k, { 0 }, false);
+            }
+            const int ret = llama_decode(ctx, batch);
+            llama_batch_free(batch);
+            if (ret != 0) {
+                LOG_ERR("%s: llama_decode failed (%d) at row %d\n", __func__, ret, r);
+                return false;
+            }
+            for (int k = 0; k < n; ++k) {
+                const float * h = llama_get_embeddings_nextn_ith(ctx, k);
+                hidden.insert(hidden.end(), h, h + n_embd);
+            }
+        }
+    }
+
+    if (!write_floats(params.dump_nextn_dir, params.chunk_index, "hidden", hidden)) {
+        return false;
+    }
+
+    if (!params.dump_mtp_out) {
+        return true;
+    }
+    if (n_rows != 1) {
+        LOG_ERR("%s: --dump-mtp-out needs exactly one row (it is a probe, not a harvest)\n", __func__);
+        return false;
+    }
+
+    return dump_mtp_output(model, ctx, params, ids, hidden, n_embd);
+}
+
+// Run the MTP block itself and dump its output hidden state and logits (probe only).
+//
+// This is the fidelity check: the block is the runtime's own graph, fed the same
+// post-output-norm hidden state the harvest collected. Its output must match a PyTorch
+// reimplementation loaded from the same weights, or the head being trained is not the head
+// the runtime will run.
+static bool dump_mtp_output(
+        llama_model * model,
+        llama_context * ctx_tgt,
+        const common_params & params,
+        const std::vector<int32_t> & ids,
+        const std::vector<float> & hidden,
+        const int n_embd) {
+    const int n = (int) ids.size();
+
+    // Mirror common_speculative_init: the draft context takes the target's context length,
+    // shares its other-context reference, and uses the same converted params. A context
+    // built from defaults instead crashes inside the graph.
+    auto cparams = common_context_params_to_llama(params);
+    cparams.ctx_type  = LLAMA_CONTEXT_TYPE_MTP;
+    cparams.n_ctx     = llama_n_ctx(ctx_tgt);
+    cparams.n_rs_seq  = 0;
+    cparams.ctx_other = ctx_tgt;
+
+    LOG_INF("%s: creating the MTP context (n_ctx = %u)\n", __func__, llama_n_ctx(ctx_tgt));
+    llama_context * ctx_mtp = llama_init_from_model(model, cparams);
+    if (ctx_mtp == nullptr) {
+        LOG_ERR("%s: failed to create the MTP context\n", __func__);
+        return false;
+    }
+    LOG_INF("%s: MTP context ready\n", __func__);
+
+    llama_set_embeddings_nextn(ctx_mtp, true, false);
+
+    llama_batch batch = llama_batch_init(n, n_embd, 1);
+    // llama_batch_init allocates only one of token/embd; the MTP block needs both (the token
+    // for the embedding lookup, the buffer for the trunk hidden state).
+    batch.token = (llama_token *) malloc(sizeof(llama_token) * n);
+    for (int i = 0; i < n; ++i) {
+        common_batch_add(batch, ids[i], i, { 0 }, true);
+        memcpy(batch.embd + (size_t) i * n_embd, hidden.data() + (size_t) i * n_embd, n_embd * sizeof(float));
+    }
+
+    LOG_INF("%s: decoding %d tokens through the MTP block\n", __func__, n);
+    const int ret = llama_decode(ctx_mtp, batch);
+    llama_batch_free(batch);
+    if (ret != 0) {
+        LOG_ERR("%s: MTP decode failed (%d)\n", __func__, ret);
+        llama_free(ctx_mtp);
+        return false;
+    }
+    LOG_INF("%s: MTP decode done, reading back\n", __func__);
+
+    std::vector<float> out;
+    out.reserve((size_t) n * n_embd);
+    for (int i = 0; i < n; ++i) {
+        const float * h = llama_get_embeddings_nextn_ith(ctx_mtp, i);
+        out.insert(out.end(), h, h + n_embd);
+    }
+
+    const int n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model));
+    std::vector<float> logits;
+    logits.reserve((size_t) n * n_vocab);
+    for (int i = 0; i < n; ++i) {
+        const float * l = llama_get_logits_ith(ctx_mtp, i);
+        logits.insert(logits.end(), l, l + n_vocab);
+    }
+
+    const bool ok = write_floats(params.dump_nextn_dir, params.chunk_index, "out",    out) &&
+                    write_floats(params.dump_nextn_dir, params.chunk_index, "logits", logits);
+
+    llama_free(ctx_mtp);
+    return ok;
+}
+
+// Debug: print the first few values of the MTP graph's named intermediate tensors, so a
+// mismatch with the PyTorch head can be localised to a node instead of guessed at.
+static bool mtp_debug_cb(struct ggml_tensor * t, bool ask, void * /*user_data*/) {
+    if (ask) {
+        return true;
+    }
+    const char * name = ggml_get_name(t);
+    if (name == nullptr) {
+        return true;
+    }
+    static const char * want[] = {
+        "mtp_tok_embd", "mtp_h_input", "mtp_hnorm", "mtp_enorm", "mtp_concat",
+        "mtp_eh_proj", "mtp_attn_norm", "mtp_attn_out", "mtp_post_ffn",
+        "h_nextn", "result_output",
+    };
+    bool hit = false;
+    for (const char * w : want) {
+        // cb() appends "-<layer>" when a layer index is passed, so compare the prefix.
+        if (strncmp(name, w, strlen(w)) == 0) {
+            hit = true;
+            break;
+        }
+    }
+    if (!hit) {
+        return true;
+    }
+    float buf[4] = { 0, 0, 0, 0 };
+    const size_t n = std::min<size_t>(4, ggml_nelements(t));
+    if (t->buffer != nullptr) {
+        ggml_backend_tensor_get(t, buf, 0, n * sizeof(float));
+    }
+    LOG_INF("DBG %-16s ne=[%lld,%lld] row0: %.6f %.6f %.6f %.6f\n",
+            name, (long long) t->ne[0], (long long) t->ne[1], buf[0], buf[1], buf[2], buf[3]);
+    return true;
+}
