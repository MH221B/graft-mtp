+static bool write_floats(const std::string & dir, int chunk, const char * suffix, const std::vector<float> & data) {
+    char path[1024];
+    snprintf(path, sizeof(path), "%s/chunk-%05d.%s.bin", dir.c_str(), chunk, suffix);
+    FILE * f = fopen(path, "wb");
+    if (f == nullptr) {
+        LOG_ERR("%s: cannot write %s\n", __func__, path);
+        return false;
+    }
+    const size_t written = fwrite(data.data(), sizeof(float), data.size(), f);
+    fclose(f);
+    if (written != data.size()) {
+        LOG_ERR("%s: short write to %s\n", __func__, path);
+        return false;
+    }
+    LOG_INF("%s: wrote %s (%zu floats)\n", __func__, path, data.size());
+    return true;
+}
+
+static std::vector<int32_t> read_i32_file(const std::string & path) {
+    FILE * f = fopen(path.c_str(), "rb");
+    if (f == nullptr) {
+        throw std::runtime_error("cannot open " + path);
+    }
+    fseek(f, 0, SEEK_END);
+    const long bytes = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    if (bytes < 0 || bytes % (long) sizeof(int32_t) != 0) {
+        fclose(f);
+        throw std::runtime_error("not a whole number of int32 values: " + path);
+    }
+    std::vector<int32_t> data(bytes / sizeof(int32_t));
+    const size_t n = fread(data.data(), sizeof(int32_t), data.size(), f);
+    fclose(f);
+    if (n != data.size()) {
+        throw std::runtime_error("short read: " + path);
+    }
+    return data;
+}
